APP_NAME="LMS Simba"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lms-simba.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# Logging: "daily" menulis ke storage/logs/laravel-YYYY-MM-DD.log (14 hari).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Isi DB_USERNAME / DB_PASSWORD di file .env lokal Anda (jangan di sini).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms_simba
# Zona waktu sesi PostgreSQL (bawaan UTC). Jangan ubah kecuali Anda paham dampaknya pada kolom timestamptz.
# DB_TIMEZONE=UTC
DB_USERNAME=
DB_PASSWORD=

# Model autentikasi: tabel pengguna (bukan users bawaan Laravel).
AUTH_MODEL=App\Models\Pengguna

# Password akun demo untuk `php artisan db:seed`. Kosong = dibuat acak & ditampilkan sekali.
SEED_DEFAULT_PASSWORD=

# Sesi (cookie SPA Sanctum). Di PRODUKSI: SESSION_SECURE_COOKIE=true (wajib HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

# Sanctum SPA: host[:port] frontend yang boleh memakai cookie sesi (tanpa skema).
# SPA dan API harus satu "site" (mis. keduanya di localhost, atau app.contoh.id & api.contoh.id).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Batas login gagal per login+IP, dan masa berlaku token reset (menit).
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300
PASSWORD_RESET_EXPIRE_MINUTES=60

# Email. "log" menulis email (termasuk tautan reset) ke storage/logs: HANYA untuk lokal.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lms-simba.test"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP lokal (mis. Mailpit/Herd Mail): MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025

CACHE_STORE=database
# Email reset password dikirim lewat antrean. Jalankan `php artisan queue:work`, atau ubah ke
# QUEUE_CONNECTION=sync untuk uji lokal cepat (email langsung diproses saat request).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# API
API_DEFAULT_PER_PAGE=15
API_MAX_PER_PAGE=100
API_RATE_LIMIT=60

# CORS: daftar origin frontend dipisah koma. Jangan pakai "*" bersama credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=true

# Reverse proxy (hanya produksi): IP/CIDR proxy dipisah koma. Kosong = tidak ada proxy dipercaya.
# TRUSTED_PROXIES=

# Materi (Backend 5): disk PRIVAT untuk file materi (jangan "public") dan batas ukuran per file (KB).
# Selaraskan dengan upload_max_filesize & post_max_size di php.ini (Herd: pengaturan PHP).
MATERI_DISK=local
MATERI_MAX_KB=20480

# Tugas & pengumpulan (Backend 6): disk PRIVAT, batas ukuran (KB), dan toleransi keterlambatan (jam).
# TUGAS_TOLERANSI_JAM=0 -> pengumpulan setelah batas_waktu ditolak; N>0 -> diterima N jam sebagai "terlambat".
TUGAS_DISK=local
TUGAS_LAMPIRAN_MAX_KB=20480
TUGAS_JAWABAN_MAX_KB=20480
TUGAS_TOLERANSI_JAM=0

# Jadwal & presensi (Backend 8) — nilai di bawah ASUMSI; sesuaikan dengan aturan sekolah.
# Titik referensi presensi (mis. gerbang sekolah). WAJIB diisi sebelum check-in berkoordinat dapat divalidasi.
PRESENSI_LAT=
PRESENSI_LNG=
PRESENSI_RADIUS_METER=100
# true = check-in wajib menyertakan koordinat; false = tanpa koordinat diterima (belum_divalidasi).
PRESENSI_LOKASI_WAJIB=true
# tolak = di luar radius ditolak (409); tandai = disimpan sebagai tidak_valid untuk ditinjau.
PRESENSI_LUAR_RADIUS=tolak
PRESENSI_BUKA_SEBELUM_MENIT=15
PRESENSI_TOLERANSI_MENIT=10
PRESENSI_ZONA_WAKTU=Asia/Jakarta
