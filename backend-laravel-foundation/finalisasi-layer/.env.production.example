# LMS Simba — TEMPLATE environment PRODUKSI. Salin ke server sebagai ".env" (atau set sebagai environment variable
# proses). Jangan commit file .env berisi nilai asli. Nilai bertanda <ISI> wajib diisi; JANGAN menaruh rahasia di file ini.
# Setelah mengisi, jalankan:  php artisan simba:cek-produksi

APP_NAME="LMS Simba"
APP_ENV=production
APP_KEY=<ISI: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://api.contoh.sekolah.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# PostgreSQL: akun KHUSUS aplikasi (bukan superuser), hanya hak pada database aplikasi.
DB_CONNECTION=pgsql
DB_HOST=<ISI>
DB_PORT=5432
DB_DATABASE=lms_simba
DB_USERNAME=<ISI>
DB_PASSWORD=<ISI>
# Untuk koneksi terenkripsi ke server database (disarankan bila tidak satu mesin): DB_SSLMODE=require

AUTH_MODEL=App\Models\Pengguna

# Sesi & Sanctum SPA. SPA dan API harus satu "site" (mis. app.contoh.sekolah.id & api.contoh.sekolah.id).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.contoh.sekolah.id
SANCTUM_STATEFUL_DOMAINS=app.contoh.sekolah.id
FRONTEND_URL=https://app.contoh.sekolah.id

# CORS: hanya origin SPA produksi (https), tanpa localhost.
CORS_ALLOWED_ORIGINS=https://app.contoh.sekolah.id
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=600

# Isi IP/CIDR reverse proxy/load balancer. Jangan "*" kecuali server tidak dapat dijangkau langsung dari internet.
TRUSTED_PROXIES=<ISI>

API_RATE_LIMIT=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300
PASSWORD_RESET_EXPIRE_MINUTES=60

# Email transaksional (reset password). Jangan "log"/"array" di produksi.
MAIL_MAILER=smtp
MAIL_HOST=<ISI>
MAIL_PORT=587
MAIL_USERNAME=<ISI>
MAIL_PASSWORD=<ISI>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@contoh.sekolah.id"
MAIL_FROM_NAME="${APP_NAME}"
QUEUE_CONNECTION=database

# Penyimpanan file privat (jangan "public"). Pastikan direktori storage tidak dapat diakses web dan DICADANGKAN.
FILESYSTEM_DISK=local
MATERI_DISK=local
TUGAS_DISK=local

# Presensi: titik referensi & aturan (ISI sesuai aturan sekolah; nilai bawaan hanya asumsi).
PRESENSI_LAT=<ISI>
PRESENSI_LNG=<ISI>
PRESENSI_RADIUS_METER=100
PRESENSI_LOKASI_WAJIB=true
PRESENSI_LUAR_RADIUS=tolak
PRESENSI_BUKA_SEBELUM_MENIT=15
PRESENSI_TOLERANSI_MENIT=10
PRESENSI_ZONA_WAKTU=Asia/Jakarta

# JANGAN isi di produksi: db:seed hanya untuk lokal.
SEED_DEFAULT_PASSWORD=
