# Salin menjadi .env (atau .env.local) lalu sesuaikan. Semua nilai VITE_* terlihat publik di bundle klien: JANGAN taruh rahasia di sini.

# true = semua service memakai data simulasi di memori (demo & vitest). Kosong/false = memanggil API Laravel.
VITE_USE_MOCK=false

# Base URL API. Disarankan RELATIF (/api/v1): dev lewat proxy Vite, produksi satu origin dengan Laravel (Railway).
VITE_API_BASE_URL=/api/v1

# Hanya dev: alamat Laravel untuk proxy Vite (default http://localhost:8000).
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Jeda simulasi jaringan untuk data mock, dalam milidetik (default 300).
VITE_MOCK_DELAY_MS=300
