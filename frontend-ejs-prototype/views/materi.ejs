<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SIMBA Admin – Master Bank Materi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/materi.css">
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar') %>
    <main class="content">

      <div class="page-head">
        <div>
          <p class="crumb">SIMBA Admin › <a href="#">Pembelajaran & Silabus</a></p>
          <h1><%= title %></h1>
        </div>
        <button class="btn btn-primary" id="btnUnggah"><i class="bi bi-plus-circle"></i> + Unggah Modul Ajar Baru</button>
        <input type="file" id="fileUnggah" accept=".pdf,.pptx,.docx,.zip" hidden>
      </div>

      <section class="mt-sum">
        <article class="card">
          <div class="mt-top"><p class="label">Total terarsip</p><span class="icon-box"><i class="bi bi-collection"></i></span></div>
          <p class="big"><%= ringkasan.arsip.total %></p>
          <p class="mt-desc"><%= ringkasan.arsip.ket %></p>
          <p class="mt-note green"><i class="bi bi-check-circle"></i> 100% Terindeks Digital</p>
        </article>
        <article class="card">
          <div class="mt-top"><p class="label">Validasi kurikulum</p><span class="icon-box bright"><i class="bi bi-patch-check"></i></span></div>
          <p class="big green"><%= ringkasan.validasi.persen %>%</p>
          <p class="mt-desc">Tervalidasi Waka Kurikulum</p>
          <p class="mt-note pink"><i class="bi bi-circle-fill dot"></i> <%= ringkasan.validasi.antrean %> modul dalam antrean review</p>
        </article>
        <article class="card">
          <div class="mt-top"><p class="label">Unduhan pekan ini</p><span class="icon-box"><i class="bi bi-arrow-down-circle"></i></span></div>
          <p class="big"><%= ringkasan.unduhan.total %></p>
          <p class="mt-desc">Kali Akses Materi Mandiri Siswa</p>
          <p class="mt-note green"><i class="bi bi-graph-up-arrow"></i> <%= ringkasan.unduhan.naik %> dari pekan sebelumnya</p>
        </article>
      </section>

      <div class="mt-grid">
        <div class="mt-col">
          <section class="card mt-filter">
            <label class="search-box"><i class="bi bi-search"></i><input type="search" id="cari" placeholder="Cari materi, judul, atau penyusun"></label>
            <select id="fTingkat" aria-label="Filter tingkat"><option value="">Semua Tingkat</option><% opsi.tingkat.forEach(t => { %><option value="<%= t %>">Kelas <%= t %></option><% }) %></select>
            <select id="fMapel" aria-label="Filter mapel"><option value="">Semua Mapel</option><% opsi.mapel.forEach(m => { %><option><%= m %></option><% }) %></select>
            <select id="fStatus" aria-label="Filter status validasi"><option value="">Status Validasi</option><% opsi.status.forEach(s => { %><option value="<%= s.v %>"><%= s.l %></option><% }) %></select>
          </section>

          <div class="mt-listhead">
            <span class="mt-title">DAFTAR MODUL & PERANGKAT AJAR <span class="pill gray" id="jumlah"><%= modul.length %> item ditampilkan</span></span>
            <button class="mt-sort" id="btnUrut">Urutkan: <span id="urutLabel">Teranyar</span> <i class="bi bi-arrow-down-up"></i></button>
          </div>

          <div class="mt-list" id="daftar">
            <% modul.forEach(m => { %>
              <article class="card mod" data-tingkat="<%= m.tingkat %>" data-mapel="<%= m.mapel %>" data-status="<%= m.status %>" data-urutan="<%= m.urutan %>">
                <span class="mod-icon w-<%= m.warna %>"><i class="bi <%= m.icon %>"></i></span>
                <div class="mod-body">
                  <p class="mod-meta"><span class="badge <%= m.status === 'verified' ? 'b-ok' : 'b-bad' %>"><i class="bi <%= m.status === 'verified' ? 'bi-patch-check' : 'bi-exclamation-circle' %>"></i> <%= m.label %></span><span class="muted"><%= m.fase %></span></p>
                  <h3><%= m.judul %></h3>
                  <p class="mod-author"><i class="bi bi-person"></i> <%= m.penyusun %></p>
                  <% if (m.status === 'verified') { %>
                    <p class="mod-file"><span><i class="bi <%= m.berkasIcon %>"></i> <%= m.berkas %></span><span class="green"><i class="bi bi-download"></i> <%= m.unduh %> kali unduh</span></p>
                  <% } else { %>
                    <p class="mod-file pink"><i class="bi bi-chat-left-text"></i> <%= m.catatan %></p>
                  <% } %>
                </div>
                <div class="mod-act">
                  <% if (m.status === 'verified') { %>
                    <button class="btn btn-soft" data-toast="Pratinjau dokumen belum dihubungkan ke backend."><i class="bi bi-eye"></i> Lihat</button>
                    <button class="btn btn-primary" data-toast="Unduhan dimulai (simulasi): <%= m.judul %>"><i class="bi bi-download"></i> Download</button>
                  <% } else { %>
                    <button class="btn btn-soft" data-toast="<%= m.catatan %>"><i class="bi bi-card-text"></i> Catatan Revisi</button>
                    <button class="btn btn-mint" data-toast="Editor modul belum dihubungkan ke backend."><i class="bi bi-pencil-square"></i> Buka Editor</button>
                  <% } %>
                </div>
              </article>
            <% }) %>
            <p class="empty" id="kosong" hidden>Tidak ada modul yang cocok. Ubah kata kunci atau filter.</p>
          </div>

          <div class="pager">
            <span>Menampilkan <%= paginasi.dari %> - <%= paginasi.sampai %> dari <%= paginasi.total %> Dokumen</span>
            <nav class="pages" aria-label="Halaman"><button aria-label="Sebelumnya"><i class="bi bi-chevron-left"></i></button><button class="is-active">1</button><button>2</button><button>3</button><span>...</span><button><%= paginasi.halaman %></button><button aria-label="Berikutnya"><i class="bi bi-chevron-right"></i></button></nav>
          </div>
        </div>

        <aside class="mt-col">
          <section class="card">
            <div class="card-head"><h2><i class="bi bi-clipboard-check green"></i> Antrean Verifikasi Modul</h2><span class="pill pink-pill" id="pending"><%= antrean.length %> Pending</span></div>
            <ul class="queue" id="antrean">
              <% antrean.forEach(a => { %>
                <li class="q-item">
                  <div class="q-top"><div><strong><%= a.judul %></strong><small><%= a.info %></small></div><span class="when"><%= a.waktu %></span></div>
                  <div class="q-act"><button class="btn btn-primary js-setujui"><i class="bi bi-check-lg"></i> Setujui Modul</button><button class="btn btn-soft sq" aria-label="Beri komentar" data-toast="Komentar review belum dihubungkan ke backend."><i class="bi bi-chat-left-text"></i></button></div>
                </li>
              <% }) %>
            </ul>
            <a href="#" class="link-center">Lihat Semua Antrean (<%= antreanTotal %> Modul)</a>
          </section>

          <section class="card">
            <div class="card-head"><h2><i class="bi bi-shield-check green"></i> Pedoman Format Kurikulum</h2></div>
            <div class="cover"><span><%= pedoman.gambar %></span></div>
            <ul class="rules"><% pedoman.butir.forEach(b => { %><li><i class="bi bi-check-circle"></i><span><%= b %></span></li><% }) %></ul>
            <div class="waka"><span class="initial"><%= pedoman.waka.inisial %></span><div><strong>Waka Kurikulum KBM</strong><small><%= pedoman.waka.nama %></small><a href="#" class="link-live"><i class="bi bi-chat-square-text"></i> Konsultasi Penyusunan Modul</a></div></div>
            <button class="btn btn-soft block" data-toast="Template diunduh (simulasi)."><i class="bi bi-arrow-down-circle"></i> Unduh Template Modul Satdik (.docx)</button>
          </section>
        </aside>
      </div>

      <p class="toast" id="toast" role="status" hidden></p>
    </main>
  </div>
</div>
<script src="/js/materi.js"></script>
</body>
</html>
