<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SIMBA Admin – Bank Tugas & Monitoring Evaluasi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/tugas.css">
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar') %>
    <main class="content">

      <div class="page-head">
        <div>
          <p class="crumb">SIMBA Admin › <a href="#">Evaluasi & Penilaian</a></p>
          <h1><%= title %></h1>
        </div>
        <div class="head-actions">
          <button class="btn btn-soft" id="btnEkspor"><i class="bi bi-download"></i> Ekspor Rekap Tugas (.XLSX)</button>
          <button class="btn btn-primary" data-toast="Form standar penugasan belum dihubungkan ke backend."><i class="bi bi-plus-circle"></i> + Buat Standar Penugasan Baru</button>
        </div>
      </div>

      <section class="tg-sum">
        <article class="card">
          <div class="tg-top"><p class="label">Total Tugas Aktif di Sekolah</p><span class="icon-box sm"><i class="bi bi-journal-text"></i></span></div>
          <p class="big"><%= ringkasan.aktif.total %> <small>Penugasan</small></p>
          <p class="tg-note green"><i class="bi bi-check-circle"></i> <%= ringkasan.aktif.ket %></p>
        </article>
        <article class="card">
          <div class="tg-top"><p class="label">Tingkat Pengumpulan Tepat Waktu</p><span class="icon-box sm bright"><i class="bi bi-pie-chart"></i></span></div>
          <p class="big green"><%= ringkasan.tepatWaktu.persen %>% <small><i class="bi bi-arrow-up"></i><%= ringkasan.tepatWaktu.naik %></small></p>
          <p class="tg-note"><i class="bi bi-shield-check green"></i> <%= ringkasan.tepatWaktu.ket %></p>
        </article>
        <article class="card">
          <div class="tg-top"><p class="label">Menunggu Koreksi Guru</p><span class="icon-box sm pinkbox"><i class="bi bi-clipboard2-pulse"></i></span></div>
          <p class="big"><%= ringkasan.koreksi.total %> <small>Berkas Prioritas</small></p>
          <p class="tg-note pink"><i class="bi bi-clock"></i> <%= ringkasan.koreksi.ket %></p>
        </article>
        <article class="card">
          <div class="tg-top"><p class="label">Rata-Rata Nilai Tugas Satdik</p><span class="icon-box sm"><i class="bi bi-bar-chart"></i></span></div>
          <p class="big"><%= ringkasan.rataNilai.nilai %> <small>/ 100</small></p>
          <p class="tg-note green"><i class="bi bi-graph-up-arrow"></i> Di atas KKM/KKTP Nasional (<%= ringkasan.rataNilai.kkm.toFixed(1) %>)</p>
        </article>
      </section>

      <section class="card tg-filter">
        <select id="fRombel" aria-label="Filter rombel"><option value="">Semua Rombel</option><% opsi.rombel.forEach(r => { %><option><%= r %></option><% }) %></select>
        <select id="fMapel" aria-label="Filter mata pelajaran"><option value="">Semua Mata Pelajaran</option><% opsi.mapel.forEach(m => { %><option><%= m %></option><% }) %></select>
        <select id="fStatus" aria-label="Filter status"><option value="">Semua Status</option><% opsi.status.forEach(s => { %><option value="<%= s.v %>"><%= s.l %></option><% }) %></select>
        <button class="tg-reset" id="btnReset"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
        <label class="search-box"><i class="bi bi-search"></i><input type="search" id="cari" placeholder="Cari Kode atau Topik Tugas..."></label>
      </section>

      <div class="tg-grid">
        <section class="card tg-table">
          <div class="card-head">
            <h2 class="tg-h"><i class="bi bi-folder-check green"></i> Daftar Penugasan Aktif & Arsip Satdik</h2>
            <span class="muted" id="infoAtas"></span>
          </div>
          <div class="table-wrap">
            <table class="table tg-t">
              <thead><tr><th>Kode & Nama Tugas</th><th>Rombel</th><th>Guru Pengampu</th><th>Batas Tenggat</th><th>Progres Pengumpulan</th><th>Status Evaluasi</th></tr></thead>
              <tbody id="baris">
                <% tugas.forEach(t => { const p = Math.floor(t.kumpul / t.total * 100); %>
                <tr data-rombel="<%= t.rombel %>" data-mapel="<%= t.mapel %>" data-status="<%= t.status %>">
                  <td><strong><%= t.nama %></strong><a href="#" class="kode"><%= t.kode %></a></td>
                  <td><span class="rombel-chip"><%= t.rombelTampil %></span></td>
                  <td><%= t.guru %></td>
                  <td class="<%= t.hariIni ? 'due-today' : '' %>"><% if (t.hariIni) { %><i class="bi bi-alarm"></i> <% } %><%= t.batas %></td>
                  <td><div class="prog-top"><span><%= t.kumpul %> / <%= t.total %> Siswa</span><strong><%= p %>%</strong></div><div class="bar sm <%= t.status === 'berjalan' ? 'dark' : '' %>"><span style="width:<%= p %>%"></span></div></td>
                  <td><span class="st st-<%= t.status %>"><% if (t.status === 'menunggu') { %><%= t.menunggu %> <% } %><%= statusLabel[t.status] %></span></td>
                </tr>
                <% }) %>
                <tr id="kosong" hidden><td colspan="6" class="empty">Tidak ada tugas yang cocok. Ubah kata kunci atau filter.</td></tr>
              </tbody>
            </table>
          </div>
          <div class="tg-pager">
            <span id="infoBawah"></span>
            <nav class="pages" id="halaman" aria-label="Halaman"></nav>
          </div>
        </section>

        <aside class="tg-side">
          <section class="card">
            <div class="card-head"><h2>Distribusi Jenis Tugas</h2><i class="bi bi-pie-chart muted"></i></div>
            <div class="donut" style="--d:conic-gradient(<%
              let acc = 0; %><%- jenis.map(j => { const a = acc; acc += j.persen; return j.warna + ' ' + a + '% ' + acc + '%'; }).join(', ') %>)"></div>
            <ul class="legend">
              <% jenis.forEach(j => { %><li><span><i style="background:<%= j.warna %>"></i><%= j.nama %></span><strong><%= j.persen %>%</strong></li><% }) %>
            </ul>
          </section>
          <section class="card">
            <div class="card-head"><h2>Kepatuhan Koreksi Pengampu</h2><i class="bi bi-sliders muted"></i></div>
            <p class="tg-desc"><%= kepatuhan.persen %>% guru menyelesaikan rekap nilai sebelum batas tenggat pelaporan mingguan TU.</p>
            <div class="ai-box"><span class="icon-box sm bright"><i class="bi bi-robot"></i></span><div><strong>AI Grader Standby</strong><small><%= kepatuhan.aiGrader %></small></div></div>
          </section>
        </aside>
      </div>

      <section class="card tg-audit">
        <span class="icon-box audit-ic"><i class="bi bi-newspaper"></i></span>
        <div class="audit-body">
          <h3>Audit Integritas Portofolio & Anti-Plagiasi <span class="pill"><%= audit.konektor %></span></h3>
          <p>Sistem otomatis memindai kesamaan dokumen antar-siswa se-Satdik dan mendeteksi berkas terindikasi kecerdasan buatan dengan ambang toleransi standar SIMBA (Maksimal <%= audit.toleransi %>% kemiripan).</p>
        </div>
        <div class="audit-act">
          <button class="btn btn-soft" data-toast="Log audit belum dihubungkan ke backend."><i class="bi bi-gear"></i> Log Audit Berkas</button>
          <button class="btn btn-primary" id="btnPeringatan"><i class="bi bi-send"></i> Kirim Peringatan Tenggat Massal</button>
        </div>
      </section>

      <p class="toast" id="toast" role="status" hidden></p>
    </main>
  </div>
</div>
<script>window.TUGAS_META = { total: <%= total %>, ukuran: <%= halamanUkuran %> };</script>
<script src="/js/tugas.js"></script>
</body>
</html>
