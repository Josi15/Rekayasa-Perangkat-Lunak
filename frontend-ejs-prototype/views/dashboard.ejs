        <tbody>
          <tr><td><div class="kls"><span class="kb">XII</span><div><b>XII MIPA 1</b><small>Biologi Molekuler</small></div></div></td><td><b>Ibu Siti Rahmawati, M.Pd.</b><div class="nip">NIP. 198204122005012004</div></td><td><span class="rg">Lab Biologi 2</span></td><td class="pr"><b>34 / 36</b><small>(2 Izin)</small><div class="bar"><i style="width:94%"></i></div></td><td class="lv">Live<br>Monitor</td></tr>
          <tr><td><div class="kls"><span class="kb">XI</span><div><b>XI IPS 2</b><small>Sosiologi Perubahan</small></div></div></td><td><b>Pak Hendra Wijaya, S.Sos.</b><div class="nip">NIP. 197809152003121002</div></td><td><span class="rg">Ruang Teori 204</span></td><td class="pr"><b>35 / 36</b><small>(1 Sakit)</small><div class="bar"><i style="width:97%"></i></div></td><td class="lv">Live<br>Monitor</td></tr>
          <tr><td><div class="kls"><span class="kb">X</span><div><b>X-4</b><small>Matematika Diskrit</small></div></div></td><td><b>Dra. Ratna Purwanti</b><div class="nip">NIP. 197405101999032001</div></td><td><span class="rg">Ruang Teori 102</span></td><td class="pr"><b>36 / 36</b><small>(Lengkap)</small><div class="bar"><i style="width:100%"></i></div></td><td class="lv">Live<br>Monitor</td></tr>
        </tbody></table></div>
    </div>
    <div class="card">
      <div class="row"><h2>Tindakan Cepat (Admin Tools)</h2></div>
      <div class="tools">
        <button class="tool" data-t="Tambah Akun Massal"><span class="ic">📄</span><span><b>Tambah Akun Massal</b><small>Import template format CSV / Excel</small></span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
        <button class="tool" data-t="Generate Token CBT"><span class="ic n">🔑</span><span><b>Generate Token CBT Pengawas</b><small>Perbarui token acak berkala 15 menit</small></span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
        <button class="tool" data-t="Backup Database Harian"><span class="ic n">☁️</span><span><b>Backup Database Harian</b><small>Dump berkas arsip .SQL terenkripsi</small></span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
