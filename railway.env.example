# Variabel service "simba" di Railway (tab Variables → Raw Editor). TEMPLATE: jangan taruh nilai rahasia asli di repo.
# ${{...}} adalah reference variable Railway (ganti "Postgres" bila nama service database Anda berbeda).

# --- Aplikasi ---
APP_NAME="LMS Simba"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<ISI: php artisan key:generate --show  (jalankan di lokal, salin hasil base64:...)>
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_LOCALE=id
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# --- Database (service PostgreSQL Railway) ---
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
AUTH_MODEL=App\Models\Pengguna

# --- Sesi & Sanctum SPA (satu origin) ---
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SESSION_DOMAIN: JANGAN DIISI (kosong/tidak ada) karena satu origin
SANCTUM_STATEFUL_DOMAINS=${{RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# Satu origin = CORS tidak dipakai browser, tapi simba:cek-produksi mewajibkan nilai https eksplisit.
CORS_ALLOWED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}
CORS_SUPPORTS_CREDENTIALS=true

# --- Proxy Railway (JANGAN "*") ---
# 100.64.0.0/10 = alamat peer yang teramati dari edge Railway; Railway TIDAK menjamin rentang ini tetap. Verifikasi (lihat docs/TAHAP-4.md).
TRUSTED_PROXIES=100.64.0.0/10

# --- Antrean, cache, berkas ---
# Satu service tanpa worker -> sync agar email reset password langsung terkirim.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MATERI_DISK=local
TUGAS_DISK=local

# --- Email (wajib bukan log/array agar reset password jalan) ---
MAIL_MAILER=smtp
MAIL_HOST=<ISI>
MAIL_PORT=587
MAIL_USERNAME=<ISI>
MAIL_PASSWORD=<ISI>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=<ISI: no-reply@domain-anda>
MAIL_FROM_NAME="${APP_NAME}"

# --- Presensi (sesuaikan aturan sekolah) ---
PRESENSI_LAT=<ISI>
PRESENSI_LNG=<ISI>
PRESENSI_RADIUS_METER=100
PRESENSI_ZONA_WAKTU=Asia/Jakarta

# --- Hardening ---
LOGIN_MAX_ATTEMPTS=5
API_RATE_LIMIT=60
# JANGAN diisi di produksi:
# SEED_DEFAULT_PASSWORD=
# PORT disuntik Railway otomatis.

# --- OPSIONAL: data demo (1 admin 'admin', 5 guru, 30 siswa, kelas, materi, dst.) HANYA untuk uji/demo ---
# SEED_DEMO=true
# SEED_DEFAULT_PASSWORD=<password kuat; dipakai SEMUA akun demo>
# Hapus kedua variabel setelah data terbentuk. Jangan dipakai untuk data sekolah sungguhan.
